    {
      "id": "npc-effect.protection-from-evil",
      "name": "Protection from Evil",
      "catalogStatus": "resolved",
      "kind": "spell",
      "duration": "1 minute/level (D)",
      "rulesText": "+2 deflection AC (including touch, flat-footed and CMD) and +2 resistance saves only against attacks made or effects created by evil creatures. New save against existing mental control from evil creatures/objects, with +2 morale; success suppresses control for the duration. Prevents new possession/mental control by those sources, subject to GM discretion. Blocks bodily contact by evil summoned creatures; spell resistance can bypass the contact barrier, and attacking or forcing the barrier against a blocked creature ends that contact protection. No blanket immunity to mind-affecting effects.",
      "parameters": [],
      "tiers": [
        {
          "level": 1,
          "modifiers": [
            {
              "stat": "ac",
              "type": "deflection",
              "value": 2,
              "condition": "against attacks made or effects created by evil creatures"
            },
            {
              "stat": "saves",
              "type": "resistance",
              "value": 2,
              "condition": "against attacks made or effects created by evil creatures"
            },
            {
              "stat": "saves",
              "type": "morale",
              "value": 2,
              "condition": "on the new save against existing mental control by evil creatures/objects"
            }
          ]
        }
      ],
      "restrictions": [],
      "sourceRef": [
        {
          "sourceId": "source.aon-spell-protection-from-evil",
          "section": "Active effect rules",
          "txtLines": [
            1,
            16
          ],
          "provenanceStatus": "resolved"
        }
      ]
    },
